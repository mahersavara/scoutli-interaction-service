# ==================== SCOUTLI MICROSERVICES - LOCAL DEVELOPMENT ====================
# This file contains environment variables for LOCAL DEVELOPMENT ONLY
# DO NOT COMMIT THIS FILE TO GIT!
# Copy .env.example to .env and customize for your machine

# ==================== DATABASE CONFIGURATION ====================
DB_HOST=localhost
DB_PORT=5434
DB_NAME=scoutli_interaction
DB_USERNAME=scoutli
DB_PASSWORD=scoutli

# ==================== KEYCLOAK CONFIGURATION ====================
KEYCLOAK_URL=http://localhost:8180
KEYCLOAK_CLIENT_ID=scoutli-backend
KEYCLOAK_CLIENT_SECRET=secret

# ==================== KAFKA CONFIGURATION ====================
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==================== SERVICE PORTS ====================
HTTP_PORT=8083

# ==================== LOGGING ====================
LOG_LEVEL=DEBUG

# ==================== QUARKUS PROFILE ====================
QUARKUS_PROFILE=dev
